  from decimal import Decimal, ROUND_HALF_UP


class ControleCreMbaCommissions:
    """
    Contrôle du fichier CRE_MBA après traitement tarification CB.

    Positions selon le mapping CRE CB :
    - SIRET : positions 72 à 86
    - Montant brut : positions 87 à 102
    - Commission commerçant MTTTCITR : positions 414 à 425

    En Python, les index commencent à 0 :
    - 72-86 devient line[71:86]
    - 87-102 devient line[86:102]
    - 414-425 devient line[413:425]

    Règle commission :
    - CHARGE_RATE = a
    - FIXED_CHARGE = b
    - MINIMUM_CHARGE = c
    - montant_brut = x

    commission attendue = max((x * a / 100) + b, c)
    """

    def _read_lines(self, file_path):
        with open(file_path, "r", encoding="utf-8") as file:
            return [line.rstrip("\n") for line in file if line.strip()]

    def _to_amount(self, value):
        value = value.strip()

        if not value:
            return Decimal("0")

        return Decimal(value) / Decimal("100")

    def _round_centimes(self, amount):
        return amount.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)

    def _find_fee_rule(self, siret, merchant_fee_rows):
        for row in merchant_fee_rows:
            row_siret = str(row[0]).strip()

            if row_siret == siret:
                return {
                    "charge_rate": Decimal(str(row[1])),
                    "minimum_charge": Decimal(str(row[2])),
                    "fixed_charge": Decimal(str(row[3])),
                }

        raise AssertionError(f"Aucune règle MERCHANT_FEE trouvée pour le SIRET {siret}")

    def verifier_fichier_cre_mba_tarifie(self, input_file_path, output_file_path, merchant_fee_rows):
        input_lines = self._read_lines(input_file_path)
        output_lines = self._read_lines(output_file_path)

        if len(input_lines) != len(output_lines):
            raise AssertionError(
                f"Nombre de lignes différent : entrée={len(input_lines)}, sortie={len(output_lines)}"
            )

        total_brut_entree = Decimal("0")
        total_brut_sortie = Decimal("0")
        total_commission_fichier = Decimal("0")
        total_commission_attendue = Decimal("0")

        details = []

        for index, input_line in enumerate(input_lines, start=1):
            output_line = output_lines[index - 1]

            siret = output_line[71:86].strip()

            montant_brut_entree = self._to_amount(input_line[86:102])
            montant_brut_sortie = self._to_amount(output_line[86:102])
            commission_fichier = self._to_amount(output_line[413:425])

            if montant_brut_entree != montant_brut_sortie:
                raise AssertionError(
                    f"Montant brut différent ligne {index} : "
                    f"entrée={montant_brut_entree}, sortie={montant_brut_sortie}"
                )

            fee_rule = self._find_fee_rule(siret, merchant_fee_rows)

            charge_rate = fee_rule["charge_rate"]
            minimum_charge = fee_rule["minimum_charge"]
            fixed_charge = fee_rule["fixed_charge"]

            commission_calculee = (montant_brut_sortie * charge_rate / Decimal("100")) + fixed_charge
            commission_attendue = max(commission_calculee, minimum_charge)

            commission_attendue = self._round_centimes(commission_attendue)
            commission_fichier = self._round_centimes(commission_fichier)

            if commission_fichier != commission_attendue:
                raise AssertionError(
                    f"Commission incorrecte ligne {index}, SIRET={siret} : "
                    f"fichier={commission_fichier}, attendue={commission_attendue}, "
                    f"brut={montant_brut_sortie}, "
                    f"CHARGE_RATE={charge_rate}, "
                    f"FIXED_CHARGE={fixed_charge}, "
                    f"MINIMUM_CHARGE={minimum_charge}"
                )

            total_brut_entree += montant_brut_entree
            total_brut_sortie += montant_brut_sortie
            total_commission_fichier += commission_fichier
            total_commission_attendue += commission_attendue

            details.append(
                f"Ligne {index} | "
                f"SIRET={siret} | "
                f"Brut entrée={montant_brut_entree} | "
                f"Brut sortie={montant_brut_sortie} | "
                f"Commission fichier={commission_fichier} | "
                f"Commission attendue={commission_attendue}"
            )

        return {
            "nombre_lignes": len(input_lines),
            "total_brut_entree": str(total_brut_entree),
            "total_brut_sortie": str(total_brut_sortie),
            "total_commission_fichier": str(total_commission_fichier),
            "total_commission_attendue": str(total_commission_attendue),
            "details": details,
        }